# =============================================================================
# BrightLoop Platform — environment variables (EXAMPLE)
# Copy to `.env.local` in apps/web and fill with real values.
# NEVER commit real secrets. Server-only keys must NOT use the NEXT_PUBLIC_ prefix.
# =============================================================================

# ---- Supabase (public — safe to expose to the browser) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ---- Supabase (server-only — NEVER expose to the client) ----
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---- Surface hostnames (used by middleware to route subdomains) ----
NEXT_PUBLIC_PUBLIC_HOST=brightloop.co
NEXT_PUBLIC_PORTAL_HOST=app.brightloop.co
NEXT_PUBLIC_ADMIN_HOST=admin.brightloop.co

# ---- Stripe (TEST MODE during development — server-only) ----
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ---- n8n automation (server-only) ----
N8N_WEBHOOK_BASE_URL=https://n8n.example.com/webhook
N8N_WEBHOOK_SECRET=shared-hmac-secret

# ---- Email (transactional — server-only) ----
EMAIL_PROVIDER_API_KEY=your-email-key

# ---- E-signature provider (server-only; mock until decision H confirmed) ----
SIGNATURE_PROVIDER_API_KEY=your-signature-key
