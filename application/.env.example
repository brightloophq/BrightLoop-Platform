# =============================================================================
# BrightLoop Platform — environment variables (EXAMPLE)
# Copy to `.env.local` in apps/web and fill with real values.
# NEVER commit real secrets. Server-only keys must NOT use the NEXT_PUBLIC_ prefix.
# =============================================================================

# ---- Supabase (public — safe to expose to the browser) ----
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# ---- Supabase (server-only — NEVER expose to the client) ----
SUPABASE_SECRET_KEY=sb_secret_...

# ---- Supabase CLI (server-only; used for `supabase db push` + `gen types`) ----
# A Personal Access Token from https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=sbp_...
# The database password (Project Settings → Database) — for migration pushes.
SUPABASE_DB_PASSWORD=...

# ---- Surface hostnames (used by middleware to route subdomains) ----
NEXT_PUBLIC_PUBLIC_HOST=brightloop.co
NEXT_PUBLIC_PORTAL_HOST=app.brightloop.co
NEXT_PUBLIC_ADMIN_HOST=admin.brightloop.co

# ---- Stripe (TEST MODE during development — server-only) ----
# Until STRIPE_SECRET_KEY is set the app uses the deterministic MOCK provider and
# settles payments in-app. Setting a real test key selects the Stripe provider
# (see apps/web/src/lib/payments.ts). STRIPE_WEBHOOK_SECRET signs the
# /api/webhooks/payments route.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# ---- Cloudflare Turnstile (anti-bot on public signup — Decision M) ----
# Until TURNSTILE_SECRET_KEY is set the signup anti-bot check is a NO-OP. Set BOTH
# the secret and the public site key to enforce it (see apps/web/src/lib/turnstile.ts
# and apps/web/src/app/(public)/start/TurnstileWidget.tsx). Get keys at
# https://dash.cloudflare.com → Turnstile.
TURNSTILE_SECRET_KEY=0x...
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x...

# ---- n8n automation (server-only) ----
N8N_WEBHOOK_BASE_URL=https://n8n.example.com/webhook
N8N_WEBHOOK_SECRET=shared-hmac-secret

# ---- Email (transactional — server-only) ----
# Until set, the app uses the mock provider and Supabase's built-in mailer
# (2 emails/hour). Setting a real provider key removes that ceiling and enables
# real sends. See apps/web/src/lib/email.ts.
EMAIL_PROVIDER_API_KEY=your-email-key
# Optionally configure custom SMTP in the Supabase dashboard
# (Authentication → Emails → SMTP) to lift the 2/hour auth-email limit.

# ---- E-signature provider (server-only; Decision E/H) ----
# Until ESIGN_API_KEY is set the app uses the MOCK provider and the client signs
# in-app (a typed signature via the bl_client_contract_sign RPC). Setting a real
# key selects the vendor adapter (see apps/web/src/lib/signatures.ts).
# ESIGN_WEBHOOK_SECRET signs the /api/webhooks/signatures route.
ESIGN_API_KEY=your-esign-key
ESIGN_WEBHOOK_SECRET=shared-esign-secret

# ---- Data source (optional) ----
# Defaults to Supabase. Set to "placeholder" ONLY for local dev without a database.
# Never set this in production: it serves sample case studies as if they were real.
# BRIGHTLOOP_DATA_SOURCE=placeholder
