{
  "name": "brightloop-platform",
  "version": "0.0.0",
  "private": true,
  "description": "BrightLoop Business Growth Platform — monorepo (Sprint 0 foundations).",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "dev": "turbo run dev",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "check": "turbo run lint typecheck test build",
    "bootstrap:owner": "node scripts/bootstrap-owner.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@supabase/supabase-js": "^2.47.10",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vitest": "^2.1.8"
  }
}
